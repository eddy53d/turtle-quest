{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["icn1"],
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npx vite build",
  "outputDirectory": "frontend/dist/public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ]
}
